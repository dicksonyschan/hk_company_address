data/*.duckdb

# Log 檔
data/*.log

# 環境變數（含 API key，絕對不 commit）
.env
.env.*

# Python 快取
__pycache__/
*.py[cod]
*.pyo

# 虛擬環境
.venv/
venv/
env/

# IDE / 編輯器設定
.vscode/
.idea/
*.swp
*.swo

# macOS 系統檔
.DS_Store

# 測試暫存
.pytest_cache/
.coverage
htmlcov/

